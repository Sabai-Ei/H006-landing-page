# Public site origin. Leave unset until the production domain is confirmed;
# canonical URL, sitemap and Open Graph URLs are only emitted when this is set.
NEXT_PUBLIC_SITE_URL=

# Health Check visibility. Public production default: hidden.
# Set to "true" only after the promotion, medical claims and commercial terms are approved.
SHOW_HEALTH_CHECK=false

# Optional: demonstration video (off in the approved design).
SHOW_DEMO_VIDEO=false
